# Optional. Enables GitHub telemetry for private repositories.
# Create a fine-grained token with read-only access to the repositories shown in Solutions HQ.
GITHUB_TOKEN=

# AI Development Team — server only. See docs/AI_DEVELOPMENT_TEAM.md.
# Generate separate random values (at least 32 characters each).
HQ_OWNER_PASSWORD=
HQ_SESSION_SECRET=
# Exact browser-facing origin, no trailing slash (required for production writes).
HQ_APP_ORIGIN=http://localhost:3000
# Fine-grained PAT: selected target repositories only; Actions and Issues write; Pull Requests, Contents, and Checks read.
AI_TEAM_GITHUB_TOKEN=

# Private shared project context. No frontend credential prefixes.
DATABASE_URL=
# Conversational AI for Workshop, Next Steps and Prompt Builder; never dispatches tools.
OPENAI_API_KEY=
HQ_AI_MODEL=
# Max conversational attempts per project per UTC day (1-100; default 40).
HQ_AI_DAILY_LIMIT=40
